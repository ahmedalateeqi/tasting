{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qa-intelligence-platform",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash"
  }
}
